<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Galaxia Sabrina</title>
  <style>
    body {
      margin: 0;
      overflow: hidden;
      background-color: #020208;
      font-family: sans-serif;
      touch-action: none;
    }
    #gyro-btn {
      position: absolute;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      padding: 10px 20px;
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.4);
      color: #fff;
      border-radius: 20px;
      backdrop-filter: blur(8px);
      font-size: 14px;
      cursor: pointer;
      z-index: 10;
    }
  </style>
</head>
<body>

<button id="gyro-btn">Activar Giroscopio 📱</button>

<!-- Three.js y OrbitControls -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

<script>
  // 1. Escena, Cámara y Renderizador
  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x020208, 0.0018); // Niebla para profundidad

  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 2000);
  camera.position.set(0, 30, 250);

  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  document.body.appendChild(renderer.domElement);

  // 2. Controles de Cámara (Táctil: Paneo y Pinch-to-Zoom)
  const controls = new THREE.OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.dampingFactor = 0.05;
  controls.rotateSpeed = 0.8;
  controls.minDistance = 20;
  controls.maxDistance = 600;

  // 3. Iluminación
  const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
  scene.add(ambientLight);

  const pointLight = new THREE.PointLight(0xff2a5f, 2, 300);
  scene.add(pointLight);

  // 4. Generador de Textura de Texto (Sprite)
  function createTextTexture(text) {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    canvas.width = 512;
    canvas.height = 128;

    ctx.fillStyle = 'rgba(0,0,0,0)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.font = 'bold 42px "Segoe UI", Roboto, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';

    // Brillo sutil blanco
    ctx.shadowColor = 'rgba(255, 255, 255, 0.8)';
    ctx.shadowBlur = 12;
    ctx.fillStyle = '#ffffff';
    ctx.fillText(text, canvas.width / 2, canvas.height / 2);

    return new THREE.CanvasTexture(canvas);
  }

  const textTexture = createTextTexture('Te amo Sabrina');
  const textMaterial = new THREE.SpriteMaterial({
    map: textTexture,
    transparent: true,
    opacity: 0.9,
    depthWrite: false
  });

  // 5. Galaxia de Frases (Distribución Esférica con Centro Vacío)
  const phraseCount = 220;
  const minRadius = 80;   // Radio mínimo para mantener el centro vacío
  const maxRadius = 450;  // Radio máximo de dispersión

  for (let i = 0; i < phraseCount; i++) {
    const sprite = new THREE.Sprite(textMaterial.clone());

    // Coordenadas esféricas
    const radius = minRadius + Math.random() * (maxRadius - minRadius);
    const theta = Math.random() * Math.PI * 2;
    const phi = Math.acos((Math.random() * 2) - 1);

    sprite.position.x = radius * Math.sin(phi) * Math.cos(theta);
    sprite.position.y = radius * Math.sin(phi) * Math.sin(theta);
    sprite.position.z = radius * Math.cos(phi);

    // Variación de escala según profundidad
    const scale = 18 + Math.random() * 14;
    sprite.scale.set(scale * 4, scale, 1);
    
    // Opacidad atenuada en los extremos
    sprite.material.opacity = 0.4 + Math.random() * 0.6;

    scene.add(sprite);
  }

  // 6. Polvo Estelar de Fondo
  const starsGeo = new THREE.BufferGeometry();
  const starsCount = 1500;
  const starPositions = new Float32Array(starsCount * 3);

  for (let i = 0; i < starsCount * 3; i++) {
    starPositions[i] = (Math.random() - 0.5) * 1200;
  }

  starsGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
  const starsMat = new THREE.PointsMaterial({ color: 0xffffff, size: 1.2, transparent: true, opacity: 0.6 });
  const starField = new THREE.Points(starsGeo, starsMat);
  scene.add(starField);

  // 7. Corazón 3D Flotante
  const x = 0, y = 0;
  const heartShape = new THREE.Shape();
  heartShape.moveTo(x + 5, y + 5);
  heartShape.bezierCurveTo(x + 5, y + 5, x + 4, y, x, y);
  heartShape.bezierCurveTo(x - 6, y, x - 6, y + 7, x - 6, y + 7);
  heartShape.bezierCurveTo(x - 6, y + 11, x - 3, y + 15.4, x + 5, y + 19);
  heartShape.bezierCurveTo(x + 12, y + 15.4, x + 16, y + 11, x + 16, y + 7);
  heartShape.bezierCurveTo(x + 16, y + 7, x + 16, y, x + 10, y);
  heartShape.bezierCurveTo(x + 7, y, x + 5, y + 5, x + 5, y + 5);

  const extrudeSettings = { depth: 4, bevelEnabled: true, bevelSegments: 3, steps: 2, bevelSize: 1.5, bevelThickness: 1.5 };
  const heartGeo = new THREE.ExtrudeGeometry(heartShape, extrudeSettings);
  heartGeo.center();

  const heartMat = new THREE.MeshStandardMaterial({
    color: 0xff1443,
    roughness: 0.3,
    metalness: 0.2,
    emissive: 0x550015
  });

  const heartMesh = new THREE.Mesh(heartGeo, heartMat);
  heartMesh.rotation.z = Math.PI; // Orientación correcta
  scene.add(heartMesh);

  // 8. Soporte Giroscópico (Móvil)
  let gyroActive = false;
  let deviceBeta = 0;
  let deviceGamma = 0;

  const gyroBtn = document.getElementById('gyro-btn');
  gyroBtn.addEventListener('click', () => {
    if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
      DeviceOrientationEvent.requestPermission()
        .then(response => {
          if (response === 'granted') {
            window.addEventListener('deviceorientation', handleOrientation);
            gyroBtn.style.display = 'none';
            gyroActive = true;
          }
        })
        .catch(console.error);
    } else {
      window.addEventListener('deviceorientation', handleOrientation);
      gyroBtn.style.display = 'none';
      gyroActive = true;
    }
  });

  function handleOrientation(event) {
    deviceBeta = event.beta || 0;
    deviceGamma = event.gamma || 0;
  }

  // 9. Bucle de Animación
  const clock = new THREE.Clock();

  function animate() {
    requestAnimationFrame(animate);
    const t = clock.getElapsedTime();

    // Movimiento orgánico del corazón fuera del centro
    const heartRadius = 110;
    heartMesh.position.x = Math.sin(t * 0.4) * heartRadius;
    heartMesh.position.z = Math.cos(t * 0.4) * (heartRadius * 0.8);
    heartMesh.position.y = Math.sin(t * 0.8) * 35;
    
    // Rotación y latido sutil
    heartMesh.rotation.y = t * 0.5;
    const pulse = 1 + Math.sin(t * 3.5) * 0.06;
    heartMesh.scale.set(pulse, pulse, pulse);

    // La luz del corazón se mueve con él
    pointLight.position.copy(heartMesh.position);

    // Rotación suave del fondo
    starField.rotation.y = t * 0.01;

    // Aplicar giroscopio suavemente si está activo
    if (gyroActive) {
      camera.position.x += (deviceGamma * 2.5 - camera.position.x) * 0.02;
      camera.position.y += (-deviceBeta * 1.5 - camera.position.y + 40) * 0.02;
    }

    controls.update();
    renderer.render(scene, camera);
  }

  animate();

  // Ajuste al redimensionar pantalla
  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>
</body>
</html>
